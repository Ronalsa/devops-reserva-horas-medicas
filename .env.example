# Variables de entorno de ejemplo (sin valores sensibles)
# Uso: copiar este archivo como .env y ajustar los valores si es necesario.
# El archivo .env NO se sube al repositorio (está en .gitignore).

# Puerto del equipo donde se publica el servicio
APP_PORT=8080

# Versión de la imagen del servicio
APP_VERSION=1.0.0

# Entorno de ejecución
APP_ENV=local
